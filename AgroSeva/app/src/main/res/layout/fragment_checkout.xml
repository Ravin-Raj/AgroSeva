<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Order Summary Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/order_summary"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/order_summary_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@android:color/darker_gray" />

        <!-- Total Amount -->
        <TextView
            android:id="@+id/total_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/total_amount"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- User Details Section -->
        <EditText
            android:id="@+id/user_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/your_name"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/user_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/phone_number"
            android:inputType="phone"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/user_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/your_address"
            android:inputType="textPostalAddress"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/user_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/your_city_town"
            android:inputType="textPostalAddress"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/user_district"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/your_district"
            android:inputType="textPostalAddress"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/user_pincode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pincode"
            android:inputType="number"
            android:layout_marginTop="8dp" />

        <!-- Proceed to Payment Button -->
        <Button
            android:id="@+id/proceed_to_payment_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/proceed_to_payment"
            android:textColor="@color/color_white"
            android:backgroundTint="@color/green"/>
    </LinearLayout>
</ScrollView>
